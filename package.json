{
  "name": "closed-cluely",
  "version": "1.0.2",
  "description": "Private meeting assistant: live transcription, meeting context, and answers from OpenAI, Claude or Gemini",
  "main": "overlay/main.js",
  "author": "Closed Cluely contributors",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node scripts/build-panel.js && node scripts/launch.js",
    "dev": "node scripts/build-panel.js && node scripts/launch.js",
    "test": "node --test tests/*.test.js",
    "test:desktop": "node scripts/build-panel.js && node scripts/launch.js --smoke-test",
    "test:cursor": "node scripts/test-cursor.js",
    "test:interruption": "node scripts/test-interruption.js",
    "icons": "node scripts/create-icons.js",
    "postinstall": "node scripts/create-icons.js",
    "build": "node scripts/build-panel.js && electron-builder",
    "build:win": "electron-builder --win nsis portable --x64",
    "build:mac": "install-electron && node scripts/build-panel.js arm64 && electron-builder --mac dmg zip --arm64 -c.electronDist=node_modules/electron/dist",
    "build:mac:all": "node scripts/build-panel.js --all && electron-builder --mac dmg zip --arm64 --x64",
    "pack:mac": "install-electron && node scripts/build-panel.js arm64 && electron-builder --mac --dir --arm64 -c.electronDist=node_modules/electron/dist",
    "pack": "node scripts/build-panel.js && electron-builder --dir",
    "test:packaged": "electron tests/packaged-electron.cjs"
  },
  "dependencies": {
    "@openai/codex": "0.164.0",
    "dompurify": "3.4.17",
    "katex": "0.19.1",
    "marked": "18.1.1",
    "pdfjs-dist": "6.4.299",
    "sherpa-onnx-node": "2.0.2"
  },
  "overrides": {
    "global-agent": "4.1.3"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.closedcluely.app",
    "productName": "Closed Cluely",
    "directories": {
      "output": "dist"
    },
    "files": [
      "overlay/**/*",
      "package.json",
      "LICENSE",
      "NOTICE",
      "!**/*.map",
      "!node_modules/@napi-rs/**",
      "!node_modules/pdfjs-dist/build/**",
      "!node_modules/pdfjs-dist/web/**",
      "!node_modules/pdfjs-dist/image_decoders/**",
      "!node_modules/pdfjs-dist/types/**"
    ],
    "asar": true,
    "asarUnpack": [
      "overlay/native/bin/**",
      "node_modules/@openai/codex-*/vendor/**",
      "overlay/models/**",
      "node_modules/sherpa-onnx-node/**",
      "node_modules/sherpa-onnx-darwin-*/**",
      "node_modules/sherpa-onnx-win-*/**"
    ],
    "mac": {
      "icon": "overlay/assets/icon.icns",
      "identity": "-",
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "LSUIElement": true,
        "NSScreenCaptureUsageDescription": "Closed Cluely takes a screenshot only when you press Screenshot. You preview it before sending it to your AI provider.",
        "NSMicrophoneUsageDescription": "Closed Cluely listens only while you press Start listening, to transcribe your microphone and meeting audio (for example from BlackHole)."
      },
      "artifactName": "Closed-Cluely-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "Closed Cluely",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "icon": "overlay/assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Closed-Cluely-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Closed-Cluely-Portable-${version}.${ext}"
    },
    "afterSign": "scripts/sign-local.js"
  }
}
